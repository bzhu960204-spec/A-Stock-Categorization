# 复制本文件为 .env（已被 .gitignore 忽略，切勿提交），填入你自己的值。
# 后端启动时会自动读取仓库根目录的 .env（spring.config.import），真实环境变量优先级更高。
# 注意：值不要加引号，等号两侧不要留空格。

# ===== 外部数据源 =====
# Twelve Data（美股/港股/日韩台等全球股票搜索）：https://twelvedata.com
# 也可以在首页「⚙ 设置」中保存，界面保存的值优先于此处。
TWELVEDATA_API_KEY=

# 东方财富搜索建议接口 token（A 股代码/名称查询）
EASTMONEY_TOKEN=

# FRED（美元流动性监测：IORB、准备金、银行总资产等；免费申请）：https://fredaccount.stlouisfed.org/apikeys
# 没有 Key 时 FRED 数据源会被跳过，其余数据源照常工作。也可以在首页「⚙ 设置」中保存，界面保存的值优先于此处。
FRED_API_KEY=

# 美股估值监测的 HTTP 代理（host:port，仅该模块使用）。Yahoo Finance 在部分网络下直连会返回 403，此时填你的代理，例如 127.0.0.1:7890。
# MARKET_VALUATION_PROXY=

# Financial Modeling Prep（仅 scripts/fetch-valuations.mjs 使用）：https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=

# ===== 数据库（H2 文件库，可选）=====
# DB_USERNAME=sa
# DB_PASSWORD=

# ===== 网络（可选）=====
# 默认只监听本机 127.0.0.1；设为 0.0.0.0 会对局域网开放（应用无登录认证，谨慎使用）。
# 也可以用 start-dev.ps1 / start-prod.ps1 的 -Lan 参数临时开放。
# SERVER_ADDRESS=127.0.0.1
